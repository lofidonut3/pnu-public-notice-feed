{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/archive-index.schema.json",
  "title": "PNU Public Notice Feed Archive Index",
  "type": "object",
  "required": [
    "schema_version",
    "archive_version",
    "last_modified_at",
    "timezone",
    "notice_count",
    "event_count",
    "latest_event_id",
    "months",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "archive_version": {
      "type": "string"
    },
    "last_modified_at": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "notice_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_event_id": {
      "type": ["string", "null"]
    },
    "months": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/month"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "month": {
      "type": "object",
      "required": [
        "month",
        "notices_url",
        "events_url",
        "notice_count",
        "event_count",
        "notices_size_bytes",
        "events_size_bytes",
        "notices_sha256",
        "events_sha256",
        "last_modified_at",
        "first_seen_at",
        "last_seen_at"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "notices_url": {
          "type": ["string", "null"]
        },
        "events_url": {
          "type": ["string", "null"]
        },
        "notice_count": {
          "type": "integer",
          "minimum": 0
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "notices_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "events_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "notices_sha256": {
          "type": ["string", "null"]
        },
        "events_sha256": {
          "type": ["string", "null"]
        },
        "last_modified_at": {
          "type": ["string", "null"]
        },
        "first_seen_at": {
          "type": ["string", "null"]
        },
        "last_seen_at": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "notice_count",
        "event_count",
        "first_seen_at",
        "last_seen_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "notice_count": {
          "type": "integer",
          "minimum": 0
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "first_seen_at": {
          "type": ["string", "null"]
        },
        "last_seen_at": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    }
  }
}
