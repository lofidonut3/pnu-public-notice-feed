{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/archive-events.schema.json",
  "title": "PNU Public Notice Feed Monthly Event Archive",
  "type": "object",
  "required": [
    "schema_version",
    "archive_version",
    "archive_type",
    "archive_month",
    "last_modified_at",
    "timezone",
    "event_count",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "archive_version": {
      "type": "string"
    },
    "archive_type": {
      "const": "events"
    },
    "archive_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "last_modified_at": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "notice_id",
        "source_id",
        "seen_at",
        "published_at",
        "title",
        "url",
        "content_hash",
        "previous_content_hash",
        "archive_notice_file",
        "archive_notice_id"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "enum": ["added", "updated"]
        },
        "notice_id": {
          "type": "string"
        },
        "source_id": {
          "type": ["string", "null"]
        },
        "seen_at": {
          "type": "string"
        },
        "published_at": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "content_hash": {
          "type": ["string", "null"]
        },
        "previous_content_hash": {
          "type": ["string", "null"]
        },
        "archive_notice_file": {
          "type": "string"
        },
        "archive_notice_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
