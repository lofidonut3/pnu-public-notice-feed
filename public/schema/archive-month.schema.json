{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/archive-month.schema.json",
  "title": "PNU Public Notice Feed Monthly Archive",
  "type": "object",
  "required": [
    "schema_version",
    "archive_version",
    "archive_type",
    "archive_month",
    "last_modified_at",
    "timezone",
    "item_count",
    "event_count",
    "source_counts",
    "items",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "archive_version": {
      "type": "string"
    },
    "archive_type": {
      "const": "month"
    },
    "archive_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "last_modified_at": {
      "type": ["string", "null"]
    },
    "timezone": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_counts": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
