{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/feed.schema.json",
  "title": "PNU Public Notice Feed",
  "type": "object",
  "required": ["version", "title", "feed_url", "description", "_pnu", "items"],
  "properties": {
    "version": {
      "const": "https://jsonfeed.org/version/1.1"
    },
    "title": {
      "type": "string"
    },
    "home_page_url": {
      "type": "string",
      "format": "uri"
    },
    "feed_url": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string"
    },
    "_pnu": {
      "type": "object",
      "required": [
        "schema_version",
        "feed_version",
        "generated_at",
        "status_url",
        "events_url",
        "run_diff_url",
        "duplicates_url",
        "archive_index_url",
        "sources_url",
        "schema_url",
        "source_count",
        "item_count",
        "sources"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "feed_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "status_url": {
          "type": "string",
          "format": "uri"
        },
        "events_url": {
          "type": "string",
          "format": "uri"
        },
        "run_diff_url": {
          "type": "string",
          "format": "uri"
        },
        "duplicates_url": {
          "type": "string",
          "format": "uri"
        },
        "archive_index_url": {
          "type": "string",
          "format": "uri"
        },
        "sources_url": {
          "type": "string",
          "format": "uri"
        },
        "schema_url": {
          "type": "string",
          "format": "uri"
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "item_limit": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "official_url",
        "adapter",
        "category",
        "poll_interval_minutes",
        "public_only",
        "access_policy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "official_url": {
          "type": "string",
          "format": "uri"
        },
        "adapter": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "poll_interval_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "public_only": {
          "const": true
        },
        "access_policy": {
          "type": "string"
        },
        "last_checked_at": {
          "type": "string"
        },
        "last_success_at": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "url", "title", "content_text", "_pnu"],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "content_text": {
          "type": "string"
        },
        "summary": {
          "type": ["string", "null"]
        },
        "date_published": {
          "type": ["string", "null"]
        },
        "_pnu": {
          "type": "object",
          "required": [
            "source_id",
            "source_name",
            "published_at",
            "fetched_at",
            "content_access",
            "attachments",
            "tags",
            "content_hash"
          ],
          "properties": {
            "source_id": {
              "type": "string"
            },
            "source_name": {
              "type": "string"
            },
            "published_at": {
              "type": ["string", "null"]
            },
            "fetched_at": {
              "type": "string"
            },
            "detail_checked_at": {
              "type": "string"
            },
            "snippet": {
              "type": ["string", "null"]
            },
            "content_access": {
              "$ref": "#/$defs/content_access"
            },
            "attachments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/attachment"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "content_hash": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "content_access": {
      "type": "object",
      "required": [
        "detail_url",
        "requires_login",
        "content_mirrored",
        "attachments_mirrored"
      ],
      "properties": {
        "detail_url": {
          "type": "string",
          "format": "uri"
        },
        "requires_login": {
          "const": false
        },
        "content_mirrored": {
          "const": false
        },
        "attachments_mirrored": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "required": ["name", "url", "download_url", "media_type", "file_extension"],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": ["string", "null"]
        },
        "media_type": {
          "type": ["string", "null"]
        },
        "file_extension": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    }
  }
}
