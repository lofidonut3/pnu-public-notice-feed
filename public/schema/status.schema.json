{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/status.schema.json",
  "title": "PNU Public Notice Feed Status",
  "type": "object",
  "required": [
    "schema_version",
    "feed_version",
    "generated_at",
    "overall_status",
    "source_count",
    "failed_source_count",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "feed_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "overall_status": {
      "enum": ["ok", "partial"]
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_source_count": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_status"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source_status": {
      "type": "object",
      "required": [
        "id",
        "name",
        "official_url",
        "adapter",
        "category",
        "poll_interval_minutes",
        "public_only",
        "access_policy",
        "status",
        "last_checked_at",
        "last_success_at",
        "last_error_at",
        "next_check_at",
        "backoff_until",
        "error_count",
        "skipped_reason",
        "item_count",
        "error_type",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "official_url": {
          "type": "string",
          "format": "uri"
        },
        "adapter": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "poll_interval_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "public_only": {
          "const": true
        },
        "access_policy": {
          "type": "string"
        },
        "status": {
          "enum": ["ok", "error", "skipped"]
        },
        "last_checked_at": {
          "type": "string"
        },
        "last_success_at": {
          "type": ["string", "null"]
        },
        "last_error_at": {
          "type": ["string", "null"]
        },
        "next_check_at": {
          "type": ["string", "null"]
        },
        "backoff_until": {
          "type": ["string", "null"]
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_reason": {
          "type": ["string", "null"]
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_type": {
          "type": ["string", "null"]
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    }
  }
}
