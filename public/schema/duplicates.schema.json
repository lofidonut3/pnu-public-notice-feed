{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/duplicates.schema.json",
  "title": "PNU Public Notice Feed Duplicate Groups",
  "type": "object",
  "required": [
    "schema_version",
    "feed_version",
    "generated_at",
    "item_count",
    "group_count",
    "policy",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "feed_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "group_count": {
      "type": "integer",
      "minimum": 0
    },
    "policy": {
      "type": "object",
      "required": [
        "scope",
        "raw_items_preserved",
        "full_body_fetched_for_dedupe",
        "false_positive_policy"
      ],
      "properties": {
        "scope": {
          "const": "metadata_only_high_confidence"
        },
        "raw_items_preserved": {
          "const": true
        },
        "full_body_fetched_for_dedupe": {
          "const": false
        },
        "false_positive_policy": {
          "const": "avoid_suppressing_distinct_notices"
        }
      },
      "additionalProperties": true
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "id",
        "relationship",
        "confidence",
        "consumer_action",
        "canonical_item_id",
        "item_ids",
        "source_ids",
        "published_dates",
        "representative_title",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "relationship": {
          "enum": ["same_notice"]
        },
        "confidence": {
          "enum": ["high"]
        },
        "consumer_action": {
          "const": "dedupe_notifications"
        },
        "canonical_item_id": {
          "type": "string"
        },
        "item_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "published_dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "representative_title": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "enum": [
              "cross_source",
              "same_normalized_title",
              "same_published_date",
              "shared_attachment_names"
            ]
          }
        }
      },
      "additionalProperties": true
    }
  }
}
