{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/archive-notices.schema.json",
  "title": "PNU Public Notice Feed Monthly Notice Archive",
  "type": "object",
  "required": [
    "schema_version",
    "archive_version",
    "archive_type",
    "archive_month",
    "last_modified_at",
    "timezone",
    "item_count",
    "source_counts",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "archive_version": {
      "type": "string"
    },
    "archive_type": {
      "const": "notices"
    },
    "archive_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "last_modified_at": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "url", "title", "content_text", "_pnu", "_archive"],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "content_text": {
          "type": "string"
        },
        "summary": {
          "type": ["string", "null"]
        },
        "date_published": {
          "type": ["string", "null"]
        },
        "_pnu": {
          "type": "object",
          "required": ["source_id", "published_at", "content_hash", "attachments"],
          "additionalProperties": true
        },
        "_archive": {
          "type": "object",
          "required": [
            "archive_month",
            "first_seen_at",
            "last_seen_at",
            "last_changed_at",
            "current_content_hash"
          ],
          "properties": {
            "archive_month": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "first_seen_at": {
              "type": "string"
            },
            "last_seen_at": {
              "type": "string"
            },
            "last_changed_at": {
              "type": "string"
            },
            "current_content_hash": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
