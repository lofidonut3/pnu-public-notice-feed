{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofidonut3.github.io/pnu-public-notice-feed/schema/sources.schema.json",
  "title": "PNU Public Notice Feed Sources",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "official_url",
        "adapter",
        "category",
        "poll_interval_minutes",
        "public_only",
        "access_policy",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "official_url": {
          "type": "string",
          "format": "uri"
        },
        "adapter": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "poll_interval_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "public_only": {
          "const": true
        },
        "access_policy": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "menu_cd": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
