{
  "openapi": "3.1.0",
  "info": {
    "title": "PNU Public Notice Feed",
    "version": "0.2",
    "description": "Unofficial AI-friendly JSON/RSS metadata relay for public notices from Pusan National University (PNU, 부산대학교, 부산대). This project is not operated by Pusan National University."
  },
  "servers": [
    {
      "url": "https://lofidonut3.github.io/pnu-public-notice-feed",
      "description": "GitHub Pages URL for the public feed."
    }
  ],
  "paths": {
    "/agent.json": {
      "get": {
        "operationId": "getAgentCatalog",
        "summary": "Discover the current polling heartbeat, cursor, and topic views",
        "responses": {
          "200": {
            "description": "Small entry document for first-time feed consumers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema/agent.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/topics/{topic}.json": {
      "get": {
        "operationId": "getTopicPreview",
        "summary": "Get up to 20 current notice previews for a topic",
        "parameters": [
          {
            "name": "topic",
            "in": "path",
            "required": true,
            "description": "Topic ID discovered in agent.json, such as scholarship.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded active-source snapshot with source URLs and coverage metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema/topic.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/index.json": {
      "get": {
        "summary": "Feed manifest",
        "responses": {
          "200": {
            "description": "Compact manifest containing endpoint URLs, source status, source registry metadata, archive manifest, same-notice groups, and latest run diagnostics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema/index.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/events.json": {
      "get": {
        "summary": "Recent durable notice events",
        "responses": {
          "200": {
            "description": "Primary recent observed notice event stream for cursor-based agent checks. Each event is a compact routing record with source, topic, duplicate, and archive lookup fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema/events.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/latest.json": {
      "get": {
        "summary": "JSON Feed 1.1 compatible latest-discovery feed",
        "responses": {
          "200": {
            "description": "Latest-discovery public notice metadata in JSON Feed 1.1 format. For cursor-based agent checks, use events.json.",
            "content": {
              "application/feed+json": {
                "schema": {
                  "$ref": "./schema/latest.schema.json"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "./schema/latest.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/rss.xml": {
      "get": {
        "summary": "RSS 2.0 compatibility feed",
        "responses": {
          "200": {
            "description": "Latest public notice metadata as an RSS 2.0 compatibility feed.",
            "content": {
              "application/rss+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/archive/{month}.json": {
      "get": {
        "summary": "Monthly notice metadata and event archive",
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly durable archive containing notice metadata and observed notice events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema/archive-month.schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
